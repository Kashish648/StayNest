
    <% layout("/layouts/boilerplates") %>
    <div class="row mt-3">
        <div class="col-8 offset-2">
            <br/><br/>
    <h3>Create a new Listing</h3>
    <form method="POST" action="/listings"   class="needs-validation" novalidate enctype="multipart/form-data" >
        <div class="mb-3">
          <label for="title" class="form-label">Title</label>
        <input name="listing[title]" placeholder="Add a chatchy title" type="text" class="form-control" required>
        <div class="valid-feedback">
        nice title.
      </div>
        <div class="invalid-feedback">
        Please choose a title.
      </div>
        </div>
        <br/><br/>

        <div class="md-3">
            <label for="description" class="form-label">Description</label>
         <textarea name="listing[description]" class="form-control" required></textarea>
         
         <div class="valid-feedback">
        description looks eye catching
      </div>
      <div class="invalid-feedback">
        Please add add a description .
      </div>
        </div>
        <br/><br/>
         
        <!-- <div class="md-3">
            <label for="image" class="form-label">Image Link</label>
            <input name="listing[image]" placeholder="enter image URL/LINK" type="text" class="form-control " required>
            <div class="invalid-feedback">
        Please choose a Image.
      </div>
        </div> -->

         <div class="md-3">
            <label for="image" class="form-label">upload listing Image </label>
            <input name="listing[image]"  type="file" class="form-control " required>
            <!-- <div class="invalid-feedback">
        Please choose a Image. -->
      </div>
        </div>
        <br/><br/>
        
        <div class="row">
            <div class="md-3 col-md-4">
            <label for="price" class="form-label">Price</label>
          <input name="listing[price]" placeholder="1200"  class="form-control" required>
          <!-- <div class="valid-feedback">
        thankss
      </div>
          <div class="invalid-feedback">
        Please enter a valid a price.
      </div> -->
        </div>
         
        <br/><br/>


        <div class="md-3 col-md-8">
            <label for="country" class="form-label">Country</label>
            <input name="listing[country]" placeholder="India" type="text" class="form-control"required>
            <div class="invalid-feedback">
        Please choose a country.
      </div>

        </div>
         <br/><br/>

        </div>
        
        <div class="md-3">
             <label for="location" class="form-label">Location</label>
              <input name="listing[location]" placeholder="Jaipur,Rajasthan" type="text" class="form-control"required>
              <div class="valid-feedback">
        ready to go.
      </div>
              <div class="invalid-feedback">
        Please choose a location.
      </div>
        </div>
         
        <br/><br/>
        <button class="btn btn-dark add-btn mt-3" type="submit">Add</button>
        <br/><br/>
    </form>
    </div>
    </div>

  
